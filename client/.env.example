# Base URL of the HRMS API.
# Leave empty in development (Vite proxies /api to http://localhost:5000)
# or when the API serves this build from the same origin.
# Set it when the client is hosted separately, e.g. on Vercel:
# VITE_API_URL=https://hrms-api.onrender.com/api
VITE_API_URL=

# Development only (read by vite.config.js, not exposed to the browser): where the dev server proxies /api.
# Defaults to http://localhost:5000; set it when the API runs on another port, e.g.
# API_PROXY_TARGET=http://localhost:5055
