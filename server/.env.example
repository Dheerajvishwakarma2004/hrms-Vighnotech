# Runtime environment: development | production | test
NODE_ENV=development

# HTTP port (Render injects PORT automatically)
PORT=5000

# MongoDB connection string (local MongoDB or MongoDB Atlas) - REQUIRED in production
MONGODB_URI=mongodb://127.0.0.1:27017/hrms

# Secret used to sign JWTs - REQUIRED in production (min 16 characters; this example value is rejected there)
JWT_SECRET=replace-with-a-long-random-secret

# HR session lifetime (the assignment requires 2 hours); a number with a unit: s, m, h or d
JWT_EXPIRES_IN=2h

# Allowed CORS origins, comma-separated (e.g. the Vercel URL of the client)
CLIENT_URL=http://localhost:5173

# Keep-alive (production only): the server pings its own /api/health so a free host does not put it to sleep.
# On Render nothing is needed: RENDER_EXTERNAL_URL is set automatically. Elsewhere, set the public URL:
# KEEP_ALIVE_URL=https://your-app.onrender.com
# Minutes between pings (1-14, default 10)
# KEEP_ALIVE_INTERVAL_MINUTES=10
